# MongoDB Atlas free tier (M0) හෝ local mongodb
MONGODB_URI="mongodb://127.0.0.1:27017/burger_stock"

# මේක ඕනම random දිග string එකක්. Terminal එකේ මේක run කරලා ගන්න:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
